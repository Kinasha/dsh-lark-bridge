{
  "name": "@open-aiden/dsh-lark-bridge",
  "version": "0.0.10",
  "private": false,
  "type": "module",
  "description": "Feishu/Lark message bridge for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kinasha/dsh-lark-bridge.git"
  },
  "homepage": "https://github.com/Kinasha/dsh-lark-bridge#readme",
  "bugs": {
    "url": "https://github.com/Kinasha/dsh-lark-bridge/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "feishu",
    "lark",
    "agent"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/src/plugin.js",
  "types": "./dist/src/plugin.d.ts",
  "bin": {
    "dsh-lark-bridge": "dist/src/plugin-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/plugin.d.ts",
      "default": "./dist/src/plugin.js"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/plugin.*",
    "dist/src/plugin-cli.*",
    "dist/src/config.*",
    "dist/src/logger.*",
    "dist/src/bridge/**",
    "dist/src/card/**",
    "dist/src/dsh/**",
    "dist/src/html/**",
    "dist/src/lark/**",
    "dist/src/progress/**",
    "dist/src/settings/**",
    "dist/client.js",
    "dist/src/client.d.ts",
    "dsh.bundle.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "predoctor": "npm run build",
    "prerun": "npm run build",
    "preweb": "npm run build",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs && node -e \"require('node:fs').chmodSync('dist/src/plugin-cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "coverage": "node scripts/run-tests.mjs --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=70",
    "check:repo": "node scripts/check-repo.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run typecheck && npm test && npm run coverage && npm run check:repo && npm run check:package",
    "doctor": "tsx src/standalone/cli.ts doctor",
    "web": "tsx src/standalone/cli.ts web",
    "run": "tsx src/standalone/cli.ts run",
    "start": "tsx src/standalone/cli.ts start"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@resvg/resvg-js": "2.6.2",
    "beautiful-mermaid": "1.1.3",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-attachment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-schema-form": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-user-questions": "0.1.0-rc.7",
    "@types/node": "^24.2.1",
    "@types/react": "^18.3.24",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
