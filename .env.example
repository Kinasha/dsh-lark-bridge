# dsh-lark-bridge 环境变量示例
#
# 复制为 .env 后填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，不要提交它，也不要把 App Secret 写进仓库。
#
# 说明：
# - 未注释的两项为必填；其余均为可选，注释中给出的是默认值。
# - 环境变量构成 DSH Settings 的基础层；Web 端 `Settings → Plugins → 飞书桥接`
#   保存的用户层会覆盖它，重置字段后重新继承环境变量。
# - 完整选项说明见 README.md 的“可选配置”一节。

# ---------- 必填：飞书应用凭证 ----------
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=your-app-secret

# ---------- 模型凭证（由 DSH 消费，非本插件） ----------
# DEEPSEEK_API_KEY=sk-...

# ---------- 开关与 Workspace ----------
# DSH_LARK_ENABLED=1
# DSH_LARK_WORKSPACE=/absolute/path/to/project
# DSH_LARK_WORKSPACE_TITLE=MyProject
# DSH_LARK_DOMAIN=feishu                      # feishu（中国）或 lark（国际）

# ---------- 访问控制（生产环境建议设置 allowlist） ----------
# DSH_LARK_ALLOWED_SENDERS=ou_trusted_user_1,ou_trusted_user_2
# DSH_LARK_BLOCKED_SENDERS=ou_revoked_user
# DSH_LARK_ALLOW_SLASH_COMMANDS=0

# ---------- 调度与可靠性 ----------
# DSH_LARK_MAX_CONCURRENT_TOPICS=4
# DSH_LARK_MAX_PENDING_MESSAGES=256
# DSH_LARK_TURN_TIMEOUT_MS=0                  # 0 表示不超时
# DSH_LARK_EVENT_STATE_PATH=$DSH_HOME/.dsh-lark-bridge/events.json
# DSH_LARK_EVENT_RETENTION_MS=604800000       # 7 天
# DSH_LARK_EVENT_STREAM_ENABLED=1

# ---------- 用户身份授权（Web 输入以本人身份发送） ----------
# DSH_LARK_USER_AUTH_ENABLED=1
# DSH_LARK_USER_AUTH_STATE_PATH=$DSH_HOME/dsh-lark-bridge/user-auth.json
# DSH_LARK_USER_AUTH_REDIRECT_URI=http://127.0.0.1:3080/dsh-lark/auth/callback

# ---------- 回复表面与思维链 ----------
# DSH_LARK_REPLY_MODE=post                    # post 或 card
# DSH_LARK_CARDKIT_ENABLED=1
# DSH_LARK_COT_ENABLED=1
# DSH_LARK_PROGRESS_SURFACE=cot               # cot 或 card
# DSH_LARK_ALWAYS_POST_FINAL=0

# ---------- 流式与执行过程展示 ----------
# DSH_LARK_STREAM_PRINT_FREQUENCY_MS=70
# DSH_LARK_STREAM_PRINT_STEP=1
# DSH_LARK_STREAM_ELEMENT_MAX_CHARS=30000
# DSH_LARK_TOOL_DETAIL_MODE=standard          # hidden | compact | standard | detailed
# DSH_LARK_PROGRESS_STYLE=timeline            # timeline | list | plain
# DSH_LARK_THINKING_ICON=brain                # brain | sparkles | robot | none
# DSH_LARK_MAX_PROGRESS_ITEMS=100
# DSH_LARK_COLLAPSE_PROGRESS_ON_FINISH=1

# ---------- HTML 报告 ----------
# DSH_LARK_HTML_REPORTS_ENABLED=1
# DSH_LARK_HTML_REPORT_ORIGIN=http://192.168.1.10:3080
# DSH_LARK_HTML_REPORT_TTL_MS=86400000        # 24 小时

# ---------- 交互能力 ----------
# DSH_LARK_CARD_ACTIONS_ENABLED=1
# DSH_LARK_APPROVALS_ENABLED=0                # 开启等于允许飞书用户授权本机工具调用
# DSH_LARK_QUESTIONS_ENABLED=1
# DSH_LARK_BOT_MENU_ENABLED=1
# DSH_LARK_REACTION_COMMANDS_ENABLED=1
# DSH_LARK_INTERRUPT_EMOJI=X

# ---------- 入站资源 ----------
# DSH_LARK_INBOUND_RESOURCES_ENABLED=1
# DSH_LARK_MAX_INBOUND_IMAGES=4
# DSH_LARK_MAX_INBOUND_IMAGE_BYTES=5000000
